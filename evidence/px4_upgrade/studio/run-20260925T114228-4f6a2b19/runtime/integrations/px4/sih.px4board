# Overlay on the pinned upstream SITL default. SIH provides all dynamics.
CONFIG_BOARD_NOLOCKSTEP=n
CONFIG_MODULES_SIMULATION_GZ_MSGS=n
CONFIG_MODULES_SIMULATION_GZ_BRIDGE=n
CONFIG_MODULES_SIMULATION_GZ_PLUGINS=n
CONFIG_MODULES_UXRCE_DDS_CLIENT=n
CONFIG_MODULES_ZENOH=n
CONFIG_LIB_CDRSTREAM=n
CONFIG_DRIVERS_CYPHAL=n
CONFIG_DRIVERS_UAVCAN=n
CONFIG_DRIVERS_GPS=n
CONFIG_COMMON_SIMULATION=n
CONFIG_MODULES_SIMULATION_SIMULATOR_MAVLINK=n
CONFIG_MODULES_SIMULATION_SIMULATOR_SIH=y
CONFIG_MODULES_SIMULATION_BATTERY_SIMULATOR=y
CONFIG_MODULES_SIMULATION_SYSTEM_POWER_SIMULATOR=y
CONFIG_MODULES_SIMULATION_SENSOR_AGP_SIM=n
